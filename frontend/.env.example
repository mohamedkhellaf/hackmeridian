# Soroban options contract ID (C...). Leave empty to run against the in-memory mock.
# Demo: v1.3.1 CBASUA3LJEZ6G66V2JTB4OHQCHUIH5EK2ZPMLY73GTIBBDZ6JLRMJUEE (v1.3 CAMY4ZKY...2KRJ and v1.2 CAJ2WJP4...GBAX also work: v1.3 features are detected at runtime)
VITE_OPTIONS_CONTRACT_ID=

# WalletConnect (mobile wallets). Get a project id at https://cloud.reown.com, then uncomment.
# Leave unset to omit WalletConnect from the wallet list.
# VITE_WALLETCONNECT_PROJECT_ID=
