# Soroban options contract ID (C...). Leave empty to run against the in-memory mock.
# Demo: v1.3.1 CBASUA3LJEZ6G66V2JTB4OHQCHUIH5EK2ZPMLY73GTIBBDZ6JLRMJUEE (v1.3 CAMY4ZKY...2KRJ and v1.2 CAJ2WJP4...GBAX also work: v1.3 features are detected at runtime)
VITE_OPTIONS_CONTRACT_ID=

# WalletConnect (mobile wallets). Get a project id at https://cloud.reown.com, then uncomment.
# Leave unset to omit WalletConnect from the wallet list.
# VITE_WALLETCONNECT_PROJECT_ID=

# Strata Pro (experimental, Testnet only). Set to 1 to mount the Pro section (simulated on fixtures until the Pro contract passes its gate). Leave empty for the Covered-only app.
VITE_ENABLE_PRO=
# Pro on Testnet (pro v0.3.2, deploy tx 69d33168…5c51): uncomment to point the Pro UI at the deployed contract.
# VITE_PRO_CONTRACT_ID=CBZNS63L23N3Y3GHU6H57AU6OVZ3FOAPM7Z54ATDRC472Q5DWV6UVKCN
# VITE_ENABLE_PRO=1
