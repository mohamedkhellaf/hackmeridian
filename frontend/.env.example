# Soroban options contract ID (C...). Leave empty to run against the in-memory mock.
# Demo (Testnet): options v1.5 CAIKMS2B4ATWKOKW7BLWQB7Z4JASPZC4EKZ3XL72N7OYSSKKHKW4GKY6 (v1.4 CC6AI7AK...PWNK, v1.3.1 CBASUA3L...JUEE, v1.2 CAJ2WJP4...GBAX)
VITE_OPTIONS_CONTRACT_ID=

# WalletConnect (mobile wallets). Get a project id at https://cloud.reown.com, then uncomment.
# Leave unset to omit WalletConnect from the wallet list.
# VITE_WALLETCONNECT_PROJECT_ID=

# StellSec Pro (experimental, Testnet only). Set to 1 to mount the Pro section (simulated on fixtures until the Pro contract passes its gate). Leave empty for the Covered-only app.
VITE_ENABLE_PRO=

# StellSec Pro contract id (C..., Testnet). With VITE_ENABLE_PRO=1, a non-empty id switches Pro from fixtures to the live contract.
# Deployed pro v0.3.2 (deploy tx 69d33168…5c51): CBZNS63L23N3Y3GHU6H57AU6OVZ3FOAPM7Z54ATDRC472Q5DWV6UVKCN
VITE_PRO_CONTRACT_ID=
